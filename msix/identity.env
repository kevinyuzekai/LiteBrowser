# Plume MSIX 身份配置 —— 在 Partner Center 保留名称后，把下面 3 个值换成「产品管理 → 产品标识」里的真实值
# Package/Identity/Name
IDENTITY_NAME="Plume.Placeholder"
# Package/Identity/Publisher（必须以 CN= 开头）
PUBLISHER="CN=00000000-0000-0000-0000-000000000000"
# Package/Properties/PublisherDisplayName
PUBLISHER_DISPLAY_NAME="PLACEHOLDER Publisher"
# 必须与 Partner Center 中保留的应用名称完全一致
DISPLAY_NAME="Plume Browser"
# 第 4 段必须为 0；每次重新提交要比上次大
VERSION="0.1.1.0"
