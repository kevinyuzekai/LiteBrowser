{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plume Browser",
  "mainBinaryName": "Plume",
  "version": "0.1.1",
  "identifier": "com.kevinyuzekai.plume",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app"
    ],
    "publisher": "kevinyuzekai",
    "category": "Utility",
    "shortDescription": "Plume Browser",
    "longDescription": "A super lightweight web browser built on the system WebView. No account needed, local browsing history.",
    "copyright": "© 2026 kevinyuzekai",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "wix": {
        "language": [
          "zh-CN",
          "en-US"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}